# 이 파일을 복사해 .env 로 만들고 실제 키를 채운다. .env는 절대 커밋 금지.

# 공공데이터포털 (data.go.kr) — 계통한계가격/수요예측, 수급현황, 발전량, 특일정보 등
DATA_GO_KR_SERVICE_KEY=

# 기상청 API허브
KMA_API_KEY=

# 한국은행 ECOS
ECOS_API_KEY=

# 텔레그램 알림 봇 (기존 봇 재사용)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# DuckDB 파일 경로 (기본값이면 비워둬도 됨)
DUCKDB_PATH=data/warehouse.duckdb
